# Copy to .env and adjust. Placeholder values only - never commit a real .env.

# --- Pipeline database (PostgreSQL) ---
PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline:change-me@localhost:5432/pipeline

# --- Source API ---
PIPELINE_API_BASE_URL=http://localhost:8000
# Must match MOCK_API_TOKEN below when using the mock API.
PIPELINE_API_TOKEN=replace-with-a-local-dev-token

# --- HTTP behaviour ---
PIPELINE_PAGE_SIZE=500
PIPELINE_REQUEST_TIMEOUT_SECONDS=10
PIPELINE_REQUESTS_PER_SECOND=20
PIPELINE_MAX_ATTEMPTS=5
PIPELINE_BACKOFF_BASE_SECONDS=0.5
PIPELINE_BACKOFF_MAX_SECONDS=30
PIPELINE_MAX_RETRY_AFTER_SECONDS=60

# --- Incremental extraction ---
PIPELINE_LOOKBACK_SECONDS=3600
PIPELINE_MAX_PAGES_PER_RUN=10000

# --- Logging ---
PIPELINE_LOG_LEVEL=INFO
PIPELINE_LOG_FORMAT=json

# --- Mock API server ---
MOCK_API_TOKEN=replace-with-a-local-dev-token
# Directory produced by `ingest generate-data`; if empty the mock generates the
# default review dataset in memory using MOCK_SEED / MOCK_ORDER_COUNT.
MOCK_DATASET_DIR=
MOCK_SEED=42
MOCK_ORDER_COUNT=200
MOCK_RELEASE_PHASE=1
# Server-side rate limit (requests per second, 0 = disabled)
MOCK_RATE_LIMIT_RPS=0
MOCK_ENABLE_ADMIN=true

# --- Postgres container (docker compose) ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline
